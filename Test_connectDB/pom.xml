<!--
This is the Maven Project Object Model (POM) file for the ebook-authzforce-db-policy project. It defines the project structure, dependencies, and build configuration.
Làm 3 việc chính:
1. Định nghĩa thông tin cơ bản về dự án như groupId, artifactId, version.
2. Định nghĩa các dependencies cần thiết để dự án hoạt động, bao gồm Authzforce và PostgreSQL JDBC driver.
3. Cấu hình plugin để có thể chạy ứng dụng thông qua Maven.

Nó giúp:
- Chốt Java version sử dụng (17).
- Kéo dependencies cần thiết cho việc tích hợp Authzforce Core (JDBC driver) và PostgreSQL.
- Chỉ main class để chạy ứng dụng dễ dàng thông qua Maven.
-->

<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://www.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.demo.ebook</groupId>
    <artifactId>ebook-authzforce-db-policy</artifactId>
    <version>1.0-SNAPSHOT</version>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <authzforce.version>21.1.0</authzforce.version>
        <postgres.version>42.7.10</postgres.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.ow2.authzforce</groupId>
            <artifactId>authzforce-ce-core-pdp-engine</artifactId>
            <version>${authzforce.version}</version>
        </dependency>

        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>${postgres.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.1.0</version>
                <configuration>
                    <mainClass>com.demo.ebook.App</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>