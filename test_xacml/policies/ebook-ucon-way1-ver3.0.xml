<?xml version="1.0" encoding="UTF-8"?>
<!--
  CÁCH 1 - BẢN CHỈNH SỬA GỌN HƠN

  Mục tiêu của bản này:
  - Giữ đúng logic UCON đã chốt.
  - Gọn hơn bản trước bằng cách:
    + phân tầng rõ: PolicySet gốc -> PolicySet theo resource/type + phase -> Policy -> Rule
    + dùng VariableDefinition để gom các điều kiện lặp lại
    + giảm chồng chéo ở READ FULL PRE: chỉ còn 1 rule Deny + 1 rule Permit
  - Vẫn phù hợp để chạy thực tế với AuthzForce / XACML 3.0.

  Quy ước chính:
  - action:id = read (thống nhất cho đọc)
  - environment:phase = PRE | ONGOING | POST
  - resource:resource_type = book_volume | reading_session
  - environment:requested_read_scope = PREVIEW | FULL (chỉ dùng ở PRE trên book_volume)
  - Một số thuộc tính tổng hợp nên do backend/service tính sẵn rồi đưa vào Request:
      * resource:effective_access_type
      * environment:book_entry_ad_required
      * environment:book_entry_ad_completed
      * environment:periodic_ad_required
      * environment:periodic_ad_due
      * environment:periodic_ad_completed_for_cycle
      * environment:resolved_access_path      (PURCHASE | SHARED | RENTAL | FREE)
      * environment:usage_tracking_mode       (REQUIRED | OPTIONAL | NONE)

  Ý tưởng logic cốt lõi ở FULL/PRE:
  - full_access_authorized :=
        purchase_active
     OR shared_active
     OR (rental_active AND effective_access_type in {free, rental})
     OR (effective_access_type = free)
  - pre_book_ad_missing :=
        book_entry_ad_required AND NOT book_entry_ad_completed
  - Rule Deny:   full_access_authorized AND pre_book_ad_missing
  - Rule Permit: full_access_authorized

  Vì vậy policy gọn hơn, không phải lặp nhiều Permit rule tương tự nhau.
-->
<PolicySet
    xmlns="urn:oasis:names:tc:xacml:3.0:core:schema:wd-17"
    PolicySetId="root"
    Version="2.0.0"
    PolicyCombiningAlgId="urn:oasis:names:tc:xacml:3.0:policy-combining-algorithm:deny-unless-permit">

    <Target/>

    <!-- =================================================================== -->
    <!-- A. PRE trên BOOK_VOLUME                                              -->
    <!-- action = read, phase = PRE, resource:type = book_volume              -->
    <!-- =================================================================== -->
    <PolicySet
        PolicySetId="ps-book-volume-read-pre"
        Version="2.0.0"
        PolicyCombiningAlgId="urn:oasis:names:tc:xacml:3.0:policy-combining-algorithm:deny-unless-permit">

        <Target>
            <AnyOf>
                <AllOf>
                    <Match MatchId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
                        <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">book_volume</AttributeValue>
                        <AttributeDesignator Category="urn:oasis:names:tc:xacml:3.0:attribute-category:resource"
                                             AttributeId="resource:resource_type"
                                             DataType="http://www.w3.org/2001/XMLSchema#string"
                                             MustBePresent="true"/>
                    </Match>
                    <Match MatchId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
                        <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">read</AttributeValue>
                        <AttributeDesignator Category="urn:oasis:names:tc:xacml:3.0:attribute-category:action"
                                             AttributeId="action:id"
                                             DataType="http://www.w3.org/2001/XMLSchema#string"
                                             MustBePresent="true"/>
                    </Match>
                    <Match MatchId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
                        <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">PRE</AttributeValue>
                        <AttributeDesignator Category="urn:oasis:names:tc:xacml:3.0:attribute-category:environment"
                                             AttributeId="environment:phase"
                                             DataType="http://www.w3.org/2001/XMLSchema#string"
                                             MustBePresent="true"/>
                    </Match>
                </AllOf>
            </AnyOf>
        </Target>

        <!-- =============================================================== -->
        <!-- A1. PREVIEW (Policy 1 - pre-A0)                                 -->
        <!-- =============================================================== -->
        <Policy
            PolicyId="policy-preview-pre"
            Version="2.0.0"
            RuleCombiningAlgId="urn:oasis:names:tc:xacml:3.0:rule-combining-algorithm:deny-unless-permit">

            <Target>
                <AnyOf>
                    <AllOf>
                        <Match MatchId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
                            <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">PREVIEW</AttributeValue>
                            <AttributeDesignator Category="urn:oasis:names:tc:xacml:3.0:attribute-category:environment"
                                                 AttributeId="environment:requested_read_scope"
                                                 DataType="http://www.w3.org/2001/XMLSchema#string"
                                                 MustBePresent="true"/>
                        </Match>
                    </AllOf>
                </AnyOf>
            </Target>

            <Rule RuleId="permit-preview-within-limit" Effect="Permit">
                <Condition>
                    <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:integer-less-than-or-equal">
                        <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:integer-one-and-only">
                            <AttributeDesignator Category="urn:oasis:names:tc:xacml:3.0:attribute-category:environment"
                                                 AttributeId="environment:requested_chunk_no"
                                                 DataType="http://www.w3.org/2001/XMLSchema#integer"
                                                 MustBePresent="true"/>
                        </Apply>
                        <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:integer-one-and-only">
                            <AttributeDesignator Category="urn:oasis:names:tc:xacml:3.0:attribute-category:resource"
                                                 AttributeId="resource:preview_chunk_limit"
                                                 DataType="http://www.w3.org/2001/XMLSchema#integer"
                                                 MustBePresent="true"/>
                        </Apply>
                    </Apply>
                </Condition>
            </Rule>
        </Policy>

        <!-- =============================================================== -->
        <!-- A2. FULL (Policy 2 + 3 + 5 + FREE-FULL)                         -->
        <!-- Gọn hơn bản cũ: chỉ còn 1 rule Deny + 1 rule Permit             -->
        <!-- =============================================================== -->
        <Policy
            PolicyId="policy-read-full-pre"
            Version="2.0.0"
            RuleCombiningAlgId="urn:oasis:names:tc:xacml:3.0:rule-combining-algorithm:deny-overrides">

            <Target>
                <AnyOf>
                    <AllOf>
                        <Match MatchId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
                            <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">FULL</AttributeValue>
                            <AttributeDesignator Category="urn:oasis:names:tc:xacml:3.0:attribute-category:environment"
                                                 AttributeId="environment:requested_read_scope"
                                                 DataType="http://www.w3.org/2001/XMLSchema#string"
                                                 MustBePresent="true"/>
                        </Match>
                    </AllOf>
                </AnyOf>
            </Target>

            <!-- ========= Biến logic dùng chung để tránh lặp ========= -->
            <VariableDefinition VariableId="var.purchase_or_shared">
                <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:or">
                    <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:boolean-one-and-only">
                        <AttributeDesignator Category="urn:oasis:names:tc:xacml:1.0:subject-category:access-subject"
                                             AttributeId="subject:purchase_active"
                                             DataType="http://www.w3.org/2001/XMLSchema#boolean"
                                             MustBePresent="true"/>
                    </Apply>
                    <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:boolean-one-and-only">
                        <AttributeDesignator Category="urn:oasis:names:tc:xacml:1.0:subject-category:access-subject"
                                             AttributeId="subject:shared_active"
                                             DataType="http://www.w3.org/2001/XMLSchema#boolean"
                                             MustBePresent="true"/>
                    </Apply>
                </Apply>
            </VariableDefinition>

            <VariableDefinition VariableId="var.effective_access_type_is_free_or_rental">
                <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:or">
                    <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
                        <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:string-one-and-only">
                            <AttributeDesignator Category="urn:oasis:names:tc:xacml:3.0:attribute-category:resource"
                                                 AttributeId="resource:effective_access_type"
                                                 DataType="http://www.w3.org/2001/XMLSchema#string"
                                                 MustBePresent="true"/>
                        </Apply>
                        <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">free</AttributeValue>
                    </Apply>
                    <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
                        <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:string-one-and-only">
                            <AttributeDesignator Category="urn:oasis:names:tc:xacml:3.0:attribute-category:resource"
                                                 AttributeId="resource:effective_access_type"
                                                 DataType="http://www.w3.org/2001/XMLSchema#string"
                                                 MustBePresent="true"/>
                        </Apply>
                        <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">rental</AttributeValue>
                    </Apply>
                </Apply>
            </VariableDefinition>

            <VariableDefinition VariableId="var.rental_entitled">
                <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:and">
                    <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:boolean-one-and-only">
                        <AttributeDesignator Category="urn:oasis:names:tc:xacml:1.0:subject-category:access-subject"
                                             AttributeId="subject:rental_active"
                                             DataType="http://www.w3.org/2001/XMLSchema#boolean"
                                             MustBePresent="true"/>
                    </Apply>
                    <VariableReference VariableId="var.effective_access_type_is_free_or_rental"/>
                </Apply>
            </VariableDefinition>

            <VariableDefinition VariableId="var.free_entitled">
                <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
                    <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:string-one-and-only">
                        <AttributeDesignator Category="urn:oasis:names:tc:xacml:3.0:attribute-category:resource"
                                             AttributeId="resource:effective_access_type"
                                             DataType="http://www.w3.org/2001/XMLSchema#string"
                                             MustBePresent="true"/>
                    </Apply>
                    <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">free</AttributeValue>
                </Apply>
            </VariableDefinition>

            <VariableDefinition VariableId="var.full_access_authorized">
                <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:or">
                    <VariableReference VariableId="var.purchase_or_shared"/>
                    <VariableReference VariableId="var.rental_entitled"/>
                    <VariableReference VariableId="var.free_entitled"/>
                </Apply>
            </VariableDefinition>

            <VariableDefinition VariableId="var.pre_book_ad_required">
                <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:boolean-one-and-only">
                    <AttributeDesignator Category="urn:oasis:names:tc:xacml:3.0:attribute-category:environment"
                                         AttributeId="environment:book_entry_ad_required"
                                         DataType="http://www.w3.org/2001/XMLSchema#boolean"
                                         MustBePresent="true"/>
                </Apply>
            </VariableDefinition>

            <VariableDefinition VariableId="var.pre_book_ad_completed">
                <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:boolean-one-and-only">
                    <AttributeDesignator Category="urn:oasis:names:tc:xacml:3.0:attribute-category:environment"
                                         AttributeId="environment:book_entry_ad_completed"
                                         DataType="http://www.w3.org/2001/XMLSchema#boolean"
                                         MustBePresent="true"/>
                </Apply>
            </VariableDefinition>

            <VariableDefinition VariableId="var.pre_book_ad_missing">
                <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:and">
                    <VariableReference VariableId="var.pre_book_ad_required"/>
                    <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:not">
                        <VariableReference VariableId="var.pre_book_ad_completed"/>
                    </Apply>
                </Apply>
            </VariableDefinition>

            <!-- Gate bắt buộc: có quyền đọc full nhưng còn thiếu quảng cáo -->
            <Rule RuleId="deny-when-book-entry-ad-missing" Effect="Deny">
                <Condition>
                    <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:and">
                        <VariableReference VariableId="var.full_access_authorized"/>
                        <VariableReference VariableId="var.pre_book_ad_missing"/>
                    </Apply>
                </Condition>

                <ObligationExpressions>
                    <ObligationExpression ObligationId="urn:ebook:obligation:create-book-entry-ad-log" FulfillOn="Deny">
                        <AttributeAssignmentExpression AttributeId="urn:ebook:obligation:ad-log-status">
                            <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">PENDING</AttributeValue>
                        </AttributeAssignmentExpression>
                        <AttributeAssignmentExpression AttributeId="urn:ebook:obligation:reading-session-id">
                            <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">NULL</AttributeValue>
                        </AttributeAssignmentExpression>
                    </ObligationExpression>
                </ObligationExpressions>
            </Rule>

            <!-- Cho đọc full nếu đã đủ quyền -->
            <Rule RuleId="permit-when-full-access-authorized" Effect="Permit">
                <Condition>
                    <VariableReference VariableId="var.full_access_authorized"/>
                </Condition>

                <ObligationExpressions>
                    <ObligationExpression ObligationId="urn:ebook:obligation:create-reading-session" FulfillOn="Permit">
                        <!-- Backend nên tính sẵn resolved_access_path để policy gọn hơn -->
                        <AttributeAssignmentExpression AttributeId="urn:ebook:obligation:session-access-path">
                            <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:string-one-and-only">
                                <AttributeDesignator Category="urn:oasis:names:tc:xacml:3.0:attribute-category:environment"
                                                     AttributeId="environment:resolved_access_path"
                                                     DataType="http://www.w3.org/2001/XMLSchema#string"
                                                     MustBePresent="true"/>
                            </Apply>
                        </AttributeAssignmentExpression>
                        <AttributeAssignmentExpression AttributeId="urn:ebook:obligation:usage-tracking">
                            <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:string-one-and-only">
                                <AttributeDesignator Category="urn:oasis:names:tc:xacml:3.0:attribute-category:environment"
                                                     AttributeId="environment:usage_tracking_mode"
                                                     DataType="http://www.w3.org/2001/XMLSchema#string"
                                                     MustBePresent="true"/>
                            </Apply>
                        </AttributeAssignmentExpression>
                    </ObligationExpression>
                </ObligationExpressions>
            </Rule>
        </Policy>
    </PolicySet>

    <!-- =================================================================== -->
    <!-- B. ONGOING trên READING_SESSION                                      -->
    <!-- action = read, phase = ONGOING, resource:type = reading_session      -->
    <!-- Policy 4 + 6                                                         -->
    <!-- =================================================================== -->
    <PolicySet
        PolicySetId="ps-reading-session-read-ongoing"
        Version="2.0.0"
        PolicyCombiningAlgId="urn:oasis:names:tc:xacml:3.0:policy-combining-algorithm:deny-unless-permit">

        <Target>
            <AnyOf>
                <AllOf>
                    <Match MatchId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
                        <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">reading_session</AttributeValue>
                        <AttributeDesignator Category="urn:oasis:names:tc:xacml:3.0:attribute-category:resource"
                                             AttributeId="resource:resource_type"
                                             DataType="http://www.w3.org/2001/XMLSchema#string"
                                             MustBePresent="true"/>
                    </Match>
                    <Match MatchId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
                        <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">read</AttributeValue>
                        <AttributeDesignator Category="urn:oasis:names:tc:xacml:3.0:attribute-category:action"
                                             AttributeId="action:id"
                                             DataType="http://www.w3.org/2001/XMLSchema#string"
                                             MustBePresent="true"/>
                    </Match>
                    <Match MatchId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
                        <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">ONGOING</AttributeValue>
                        <AttributeDesignator Category="urn:oasis:names:tc:xacml:3.0:attribute-category:environment"
                                             AttributeId="environment:phase"
                                             DataType="http://www.w3.org/2001/XMLSchema#string"
                                             MustBePresent="true"/>
                    </Match>
                </AllOf>
            </AnyOf>
        </Target>

        <Policy
            PolicyId="policy-read-session-ongoing"
            Version="2.0.0"
            RuleCombiningAlgId="urn:oasis:names:tc:xacml:3.0:rule-combining-algorithm:deny-overrides">

            <Target/>

            <VariableDefinition VariableId="var.session_active">
                <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:boolean-one-and-only">
                    <AttributeDesignator Category="urn:oasis:names:tc:xacml:3.0:attribute-category:resource"
                                         AttributeId="resource:session_active"
                                         DataType="http://www.w3.org/2001/XMLSchema#boolean"
                                         MustBePresent="true"/>
                </Apply>
            </VariableDefinition>

            <VariableDefinition VariableId="var.is_rental_session">
                <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
                    <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:string-one-and-only">
                        <AttributeDesignator Category="urn:oasis:names:tc:xacml:3.0:attribute-category:resource"
                                             AttributeId="resource:session_access_path"
                                             DataType="http://www.w3.org/2001/XMLSchema#string"
                                             MustBePresent="true"/>
                    </Apply>
                    <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">RENTAL</AttributeValue>
                </Apply>
            </VariableDefinition>

            <VariableDefinition VariableId="var.rental_expired">
                <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:and">
                    <VariableReference VariableId="var.session_active"/>
                    <VariableReference VariableId="var.is_rental_session"/>
                    <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:not">
                        <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:boolean-one-and-only">
                            <AttributeDesignator Category="urn:oasis:names:tc:xacml:1.0:subject-category:access-subject"
                                                 AttributeId="subject:rental_active"
                                                 DataType="http://www.w3.org/2001/XMLSchema#boolean"
                                                 MustBePresent="true"/>
                        </Apply>
                    </Apply>
                </Apply>
            </VariableDefinition>

            <VariableDefinition VariableId="var.periodic_ad_required">
                <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:boolean-one-and-only">
                    <AttributeDesignator Category="urn:oasis:names:tc:xacml:3.0:attribute-category:environment"
                                         AttributeId="environment:periodic_ad_required"
                                         DataType="http://www.w3.org/2001/XMLSchema#boolean"
                                         MustBePresent="true"/>
                </Apply>
            </VariableDefinition>

            <VariableDefinition VariableId="var.periodic_ad_due">
                <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:boolean-one-and-only">
                    <AttributeDesignator Category="urn:oasis:names:tc:xacml:3.0:attribute-category:environment"
                                         AttributeId="environment:periodic_ad_due"
                                         DataType="http://www.w3.org/2001/XMLSchema#boolean"
                                         MustBePresent="true"/>
                </Apply>
            </VariableDefinition>

            <VariableDefinition VariableId="var.periodic_ad_completed_for_cycle">
                <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:boolean-one-and-only">
                    <AttributeDesignator Category="urn:oasis:names:tc:xacml:3.0:attribute-category:environment"
                                         AttributeId="environment:periodic_ad_completed_for_cycle"
                                         DataType="http://www.w3.org/2001/XMLSchema#boolean"
                                         MustBePresent="true"/>
                </Apply>
            </VariableDefinition>

            <VariableDefinition VariableId="var.periodic_ad_blocking">
                <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:and">
                    <VariableReference VariableId="var.session_active"/>
                    <VariableReference VariableId="var.periodic_ad_required"/>
                    <VariableReference VariableId="var.periodic_ad_due"/>
                    <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:not">
                        <VariableReference VariableId="var.periodic_ad_completed_for_cycle"/>
                    </Apply>
                </Apply>
            </VariableDefinition>

            <VariableDefinition VariableId="var.periodic_ad_just_completed">
                <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:and">
                    <VariableReference VariableId="var.session_active"/>
                    <VariableReference VariableId="var.periodic_ad_required"/>
                    <VariableReference VariableId="var.periodic_ad_due"/>
                    <VariableReference VariableId="var.periodic_ad_completed_for_cycle"/>
                </Apply>
            </VariableDefinition>

            <VariableDefinition VariableId="var.session_access_path_allowed">
                <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:or">
                    <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
                        <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:string-one-and-only">
                            <AttributeDesignator Category="urn:oasis:names:tc:xacml:3.0:attribute-category:resource"
                                                 AttributeId="resource:session_access_path"
                                                 DataType="http://www.w3.org/2001/XMLSchema#string"
                                                 MustBePresent="true"/>
                        </Apply>
                        <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">PURCHASE</AttributeValue>
                    </Apply>
                    <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
                        <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:string-one-and-only">
                            <AttributeDesignator Category="urn:oasis:names:tc:xacml:3.0:attribute-category:resource"
                                                 AttributeId="resource:session_access_path"
                                                 DataType="http://www.w3.org/2001/XMLSchema#string"
                                                 MustBePresent="true"/>
                        </Apply>
                        <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">SHARED</AttributeValue>
                    </Apply>
                    <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
                        <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:string-one-and-only">
                            <AttributeDesignator Category="urn:oasis:names:tc:xacml:3.0:attribute-category:resource"
                                                 AttributeId="resource:session_access_path"
                                                 DataType="http://www.w3.org/2001/XMLSchema#string"
                                                 MustBePresent="true"/>
                        </Apply>
                        <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">FREE</AttributeValue>
                    </Apply>
                    <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:and">
                        <VariableReference VariableId="var.is_rental_session"/>
                        <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:boolean-one-and-only">
                            <AttributeDesignator Category="urn:oasis:names:tc:xacml:1.0:subject-category:access-subject"
                                                 AttributeId="subject:rental_active"
                                                 DataType="http://www.w3.org/2001/XMLSchema#boolean"
                                                 MustBePresent="true"/>
                        </Apply>
                    </Apply>
                </Apply>
            </VariableDefinition>

            <VariableDefinition VariableId="var.ongoing_read_permitted_normally">
                <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:and">
                    <VariableReference VariableId="var.session_active"/>
                    <VariableReference VariableId="var.session_access_path_allowed"/>
                    <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:not">
                        <VariableReference VariableId="var.periodic_ad_blocking"/>
                    </Apply>
                    <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:not">
                        <VariableReference VariableId="var.periodic_ad_just_completed"/>
                    </Apply>
                </Apply>
            </VariableDefinition>

            <Rule RuleId="deny-rental-expired" Effect="Deny">
                <Condition>
                    <VariableReference VariableId="var.rental_expired"/>
                </Condition>
                <ObligationExpressions>
                    <ObligationExpression ObligationId="urn:ebook:obligation:revoke-reading-session" FulfillOn="Deny">
                        <AttributeAssignmentExpression AttributeId="urn:ebook:obligation:revoked-reason">
                            <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">rental_expired</AttributeValue>
                        </AttributeAssignmentExpression>
                    </ObligationExpression>
                </ObligationExpressions>
            </Rule>

            <Rule RuleId="deny-when-periodic-ad-blocking" Effect="Deny">
                <Condition>
                    <VariableReference VariableId="var.periodic_ad_blocking"/>
                </Condition>
                <ObligationExpressions>
                    <ObligationExpression ObligationId="urn:ebook:obligation:create-periodic-ad-log-and-pause-session" FulfillOn="Deny">
                        <AttributeAssignmentExpression AttributeId="urn:ebook:obligation:session-status">
                            <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">PAUSED_FOR_AD</AttributeValue>
                        </AttributeAssignmentExpression>
                        <AttributeAssignmentExpression AttributeId="urn:ebook:obligation:ad-log-status">
                            <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">PENDING</AttributeValue>
                        </AttributeAssignmentExpression>
                    </ObligationExpression>
                </ObligationExpressions>
            </Rule>

            <Rule RuleId="permit-after-periodic-ad-completed" Effect="Permit">
                <Condition>
                    <VariableReference VariableId="var.periodic_ad_just_completed"/>
                </Condition>
                <ObligationExpressions>
                    <ObligationExpression ObligationId="urn:ebook:obligation:resume-session-and-advance-next-ad-due" FulfillOn="Permit">
                        <AttributeAssignmentExpression AttributeId="urn:ebook:obligation:session-status">
                            <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">ACTIVE</AttributeValue>
                        </AttributeAssignmentExpression>
                    </ObligationExpression>
                </ObligationExpressions>
            </Rule>

            <Rule RuleId="permit-continue-read-normal" Effect="Permit">
                <Condition>
                    <VariableReference VariableId="var.ongoing_read_permitted_normally"/>
                </Condition>
            </Rule>
        </Policy>
    </PolicySet>

    <!-- =================================================================== -->
    <!-- C. POST trên READING_SESSION                                         -->
    <!-- action = read, phase = POST, resource:type = reading_session         -->
    <!-- Policy 3 (postUpdate)                                                -->
    <!-- =================================================================== -->
    <PolicySet
        PolicySetId="ps-reading-session-read-post"
        Version="2.0.0"
        PolicyCombiningAlgId="urn:oasis:names:tc:xacml:3.0:policy-combining-algorithm:deny-unless-permit">

        <Target>
            <AnyOf>
                <AllOf>
                    <Match MatchId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
                        <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">reading_session</AttributeValue>
                        <AttributeDesignator Category="urn:oasis:names:tc:xacml:3.0:attribute-category:resource"
                                             AttributeId="resource:resource_type"
                                             DataType="http://www.w3.org/2001/XMLSchema#string"
                                             MustBePresent="true"/>
                    </Match>
                    <Match MatchId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
                        <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">read</AttributeValue>
                        <AttributeDesignator Category="urn:oasis:names:tc:xacml:3.0:attribute-category:action"
                                             AttributeId="action:id"
                                             DataType="http://www.w3.org/2001/XMLSchema#string"
                                             MustBePresent="true"/>
                    </Match>
                    <Match MatchId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
                        <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">POST</AttributeValue>
                        <AttributeDesignator Category="urn:oasis:names:tc:xacml:3.0:attribute-category:environment"
                                             AttributeId="environment:phase"
                                             DataType="http://www.w3.org/2001/XMLSchema#string"
                                             MustBePresent="true"/>
                    </Match>
                    <Match MatchId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
                        <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">END</AttributeValue>
                        <AttributeDesignator Category="urn:oasis:names:tc:xacml:3.0:attribute-category:environment"
                                             AttributeId="environment:lifecycle_event"
                                             DataType="http://www.w3.org/2001/XMLSchema#string"
                                             MustBePresent="true"/>
                    </Match>
                </AllOf>
            </AnyOf>
        </Target>

        <Policy
            PolicyId="policy-read-session-post"
            Version="2.0.0"
            RuleCombiningAlgId="urn:oasis:names:tc:xacml:3.0:rule-combining-algorithm:deny-unless-permit">

            <Target/>

            <VariableDefinition VariableId="var.is_rental_session">
                <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
                    <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:string-one-and-only">
                        <AttributeDesignator Category="urn:oasis:names:tc:xacml:3.0:attribute-category:resource"
                                             AttributeId="resource:session_access_path"
                                             DataType="http://www.w3.org/2001/XMLSchema#string"
                                             MustBePresent="true"/>
                    </Apply>
                    <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">RENTAL</AttributeValue>
                </Apply>
            </VariableDefinition>

            <Rule RuleId="permit-rental-end-read-post-update" Effect="Permit">
                <Condition>
                    <VariableReference VariableId="var.is_rental_session"/>
                </Condition>
                <ObligationExpressions>
                    <ObligationExpression ObligationId="urn:ebook:obligation:write-usage-record" FulfillOn="Permit">
                        <AttributeAssignmentExpression AttributeId="urn:ebook:obligation:usage-source">
                            <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">RENTAL</AttributeValue>
                        </AttributeAssignmentExpression>
                    </ObligationExpression>
                    <ObligationExpression ObligationId="urn:ebook:obligation:close-session" FulfillOn="Permit">
                        <AttributeAssignmentExpression AttributeId="urn:ebook:obligation:final-status">
                            <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">ENDED</AttributeValue>
                        </AttributeAssignmentExpression>
                    </ObligationExpression>
                </ObligationExpressions>
            </Rule>

            <Rule RuleId="permit-non-rental-end-read-cleanup" Effect="Permit">
                <Condition>
                    <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:not">
                        <VariableReference VariableId="var.is_rental_session"/>
                    </Apply>
                </Condition>
                <ObligationExpressions>
                    <ObligationExpression ObligationId="urn:ebook:obligation:close-session" FulfillOn="Permit">
                        <AttributeAssignmentExpression AttributeId="urn:ebook:obligation:final-status">
                            <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">ENDED</AttributeValue>
                        </AttributeAssignmentExpression>
                    </ObligationExpression>
                </ObligationExpressions>
            </Rule>
        </Policy>
    </PolicySet>
</PolicySet>
